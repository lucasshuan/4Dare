      "mcp__Vercel__get_auth_user",
      "mcp__Vercel__list_teams",
      "mcp__Vercel__get_team",
      "mcp__Vercel__list_projects",
      "mcp__Vercel__get_project",
      "mcp__Vercel__filter_project_envs",
