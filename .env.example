# Leave everything empty to run in local mode (in memory, no accounts needed).

# Supabase (production backend). The Supabase integration on Vercel sets these;
# `vercel env pull .env.local` copies them here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Sightengine, the detector for pictures players send (sightengine.com, free
# plan: 2,000 operations a month). Without them, on Supabase, new pictures wait
# unchecked: only their author sees them until the daily check.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Any long random string, set on Vercel: its crons (vercel.json, the daily
# tidy-up of pictures) send it, and the route refuses calls without it.
CRON_SECRET=

# The deployed site, for share links, the sitemap and `pnpm setup:supabase`.
# On Vercel the production domain is used when this is empty.
SITE_URL=

# Only for `pnpm setup:supabase` (the app itself doesn't read these).
SUPABASE_ACCESS_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
