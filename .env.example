# Leave everything empty to run in local mode (in memory, no accounts needed).

# Supabase (production backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: lets the AI invent new themes. Without it, themes come from the built-in list.
ANTHROPIC_API_KEY=
